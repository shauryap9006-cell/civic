# Copy to .env and fill in. Never commit .env. Secrets live only in environment variables.

APP_ENV=development                 # development | production  (production disables demo endpoints)
LOG_LEVEL=INFO
THRESHOLDS_PATH=config/thresholds.yaml

# --- Database ---
DATABASE_URL=postgresql+asyncpg://civiclens:civiclens@localhost:5432/civiclens

# --- Object storage for crops (MinIO locally; Cloudflare R2 or Supabase Storage when deployed) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=civiclens-crops
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PRESIGN_TTL_S=3600

# --- Public URLs ---
API_BASE_URL=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:3000   # used to build Fixed links and map links in emails

# --- Email ---
EMAIL_PROVIDER=resend                    # resend | console (console prints the email instead of sending)
RESEND_API_KEY=
EMAIL_FROM=CivicLens <onboarding@resend.dev>
EMAIL_MODE=test                          # test = ALWAYS send to TEST_INBOX, never to authority addresses
TEST_INBOX=you@example.com

# --- Secrets ---
ADMIN_SECRET=change-me                   # protects /v1/admin/*
FIXED_TOKEN_SECRET=change-me             # HMAC key for Fixed-link tokens

# --- Demo ---
DEMO_MODE=true                           # enables /demo page and simulate-time; ignored if APP_ENV=production
